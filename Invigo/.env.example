DB_URL=jdbc:sqlserver://localhost;databaseName=Invigo;trustServerCertificate=true;
DB_USERNAME=sa
DB_PASSWORD=change-me
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=3000
MAIL_SMTP_WRITE_TIMEOUT=5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
ML_API_URL=http://localhost:8000

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_MAIL_FROM_ADDRESS=no-reply@invigo.local
APP_MAIL_FROM_NAME=Invigo FreshGuard
